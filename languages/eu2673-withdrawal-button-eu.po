msgstr "Gehitu esteka bat bezeroari bidalitako WooCommerceren eskaera-mezuetan"

msgid "The withdrawal function must be prominently displayed and available throughout the withdrawal period (Art. 11a(1))."
msgstr "Atzera egiteko funtzioak ondo ikusteko moduan eta epe osoan erabilgarri egon behar du (11 bis.1 art.)."

msgid "Order received page"
msgstr "Jasotako eskaeraren orria"

msgid "Show the button on the order received page"
