msgstr "Adierazitako arrazoia"

msgid "Si tienes alguna pregunta, responde a este correo."
msgstr "Galderarik baduzu, erantzun mezu honi."

msgid "Gracias por confiar en %s."
msgstr "Eskerrik asko %s(e)n konfiantza izateagatik."

msgid "Este correo es el acuse de recibo de tu solicitud de desistimiento."
msgstr "Mezu hau atzera egiteko zure eskaeraren hartu-agiria da."

msgid "Your withdrawal request has been <strong>approved</strong>. We will process the full refund within a maximum of <strong>14 calendar days</strong>."
msgstr "Atzera egiteko zure eskaera <strong>onartu</strong> da. Diru guztia gehienez <strong>14 egun naturaleko</strong> epean itzuliko dizugu."

msgid "Your withdrawal request has been <strong>rejected</strong>. If you have any questions, please contact us."
msgstr "Atzera egiteko zure eskaera <strong>baztertu</strong> da. Galderarik baduzu, jarri gurekin harremanetan."

msgid "Your withdrawal request has been <strong>completed</strong>. The refund has been processed correctly."
msgstr "Atzera egiteko zure eskaera <strong>osatu</strong> da. Dirua behar bezala itzuli da."

msgid "Dear"
msgstr "Kaixo"

msgid "The status of your withdrawal request has been updated."
msgstr "Atzera egiteko zure eskaeraren egoera eguneratu da."

msgid "Request number"
msgstr "Eskaera-zk."

msgid "New status"
msgstr "Egoera berria"

msgid "Updated on"
msgstr "Eguneratze-data"

msgid "Admin note:"
msgstr "Dendaren oharra:"

msgid "Thank you for trusting %s."
msgstr "Eskerrik asko %s(e)n konfiantza izateagatik."

msgid "Automatic withdrawal request update."
msgstr "Atzera egiteko zure eskaeraren eguneratze automatikoa."

msgid "Cerrar ventana de desistimiento"
msgstr "Itxi atzerapenaren leihoa"

msgid "Tienes derecho a desistir de este contrato sin necesidad de indicar el motivo."
msgstr "Kontratu honi uko egiteko eskubidea duzu, arrazoirik eman beharrik gabe."

msgid "Revisa tus datos antes de confirmar:"
msgstr "Berrikusi zure datuak berretsi aurretik:"

msgid "Motivo (opcional)"
msgstr "Arrazoia (aukerakoa)"

msgid "Al confirmar, recibirás un email de acuse de recibo y nuestro equipo procesará el reembolso en un máximo de 14 días naturales."
msgstr "Berrestean, harrera-agiria jasoko duzu posta elektronikoz eta gure taldeak gehienez 14 egun naturaleko epean tramitatu egingo du itzulketa."

