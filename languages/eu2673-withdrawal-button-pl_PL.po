msgstr "[Odstąpienie] Zamówienie nr {order_id} - {customer_name}"

msgid "Base legal: artículo 11 bis de la Directiva 2011/83/UE, introducido por la Directiva (UE) 2023/2673"
msgstr "Podstawa prawna: art. 11a dyrektywy 2011/83/UE, dodany dyrektywą (UE) 2023/2673"

