msgstr "— Niciuna —"

msgid "Page with the [eu2673_withdrawal_form] shortcode. Customers who bought without an account withdraw here with their order number and email."
msgstr "Pagina cu shortcode-ul [eu2673_withdrawal_form]. Clienții care au cumpărat fără cont se retrag aici cu numărul comenzii și adresa de e-mail."

msgid "Links to the withdrawal page"
msgstr "Linkuri către pagina de retragere"

msgid "Show a link at the bottom of every page"
msgstr "Afișați un link în partea de jos a fiecărei pagini"

msgid "Add a link to the WooCommerce order emails sent to the customer"
msgstr "Adăugați un link în e-mailurile de comandă WooCommerce trimise clientului"

msgid "The withdrawal function must be prominently displayed and available throughout the withdrawal period (Art. 11a(1))."
msgstr "Funcția de retragere trebuie să fie afișată vizibil și disponibilă pe toată perioada de retragere [art. 11a alin. (1)]."

msgid "Order received page"
msgstr "Pagina de comandă primită"

