msgid "When you change the status to Approved, Rejected or Completed, the customer receives an email with the new status and your note."
msgstr "将状态更改为“已批准”“已拒绝”或“已完成”时，客户会收到包含新状态和您备注的邮件。"

msgid "Withdrawal request #%1$d marked as %2$s."
msgstr "撤回申请 #%1$d 已标记为 %2$s。"

msgid "Withdrawal Button — Settings"
msgstr "Withdrawal Button — 设置"

msgid "Settings saved."
msgstr "设置已保存。"

msgid "The withdrawal page has been created."
msgstr "撤回页面已创建。"

msgid "View page"
msgstr "查看页面"

msgid "The withdrawal page could not be created."
msgstr "无法创建撤回页面。"

msgid "Withdrawal period"
msgstr "撤回期"

msgid "Withdrawal period (days)"
msgstr "撤回期（天）"

msgid "Legal minimum is 14 calendar days. You can offer more."
msgstr "法定最短期限为 14 个自然日。您可以提供更长期限。"

msgid "Grace days (optional)"
msgstr "宽限天数（可选）"

msgid "Extra days on top of the legal deadline."
msgstr "在法定期限之外增加的天数。"

msgid "Start deadline from"
msgstr "期限起算日"

msgid "Delivery date (when order is completed)"
msgstr "交付日期（订单完成时）"

msgid "Order date"
msgstr "订单日期"

msgid "For goods, the period starts when the customer receives them (Art. 9(2)(b) of Directive 2011/83/EU): mark the order as Completed when it is delivered. Until then the button stays available. Use the order date only if you sell services or digital content."
msgstr "对于商品，期限自客户收到商品时起算（第 2011/83/EU 号指令第 9 条第 2 款 (b) 项）：交付时请将订单标记为“已完成”。在此之前按钮始终可用。仅在销售服务或数字内容时使用订单日期。"

msgid "Do not show the button for orders with these statuses"
msgstr "以下状态的订单不显示按钮"

msgid "Do not exclude Completed: customers usually withdraw after receiving the order."
msgstr "请勿排除“已完成”：客户通常在收到订单后撤回。"

msgid "Where the button appears"
msgstr "按钮显示位置"

msgid "Button text"
msgstr "按钮文字"

msgid "Desistir del contrato aquí"
msgstr "在此撤回合同"

msgid "Leave empty to use the wording of the Directive (\"withdraw from contract here\"), translated into the store language."
msgstr "留空则使用指令中的表述（“在此撤回合同”），并翻译为商店语言。"

msgid "Public withdrawal page"
msgstr "公开撤回页面"

msgid "— None —"
msgstr "— 无 —"

msgid "Page with the [eu2673_withdrawal_form] shortcode. Customers who bought without an account withdraw here with their order number and email."
msgstr "包含短代码 [eu2673_withdrawal_form] 的页面。无账户购买的客户在此使用订单号和电子邮箱撤回。"

msgid "Links to the withdrawal page"
msgstr "撤回页面链接"

msgid "Show a link at the bottom of every page"
msgstr "在每个页面底部显示链接"

msgid "Add a link to the WooCommerce order emails sent to the customer"
msgstr "在发送给客户的 WooCommerce 订单邮件中添加链接"

msgid "The withdrawal function must be prominently displayed and available throughout the withdrawal period (Art. 11a(1))."
msgstr "撤回功能必须显著展示，并在整个撤回期内可用（第 11a 条第 1 款）。"

msgid "Order received page"
msgstr "订单已收到页面"

msgid "Show the button on the order received page"
msgstr "在订单已收到页面显示按钮"

msgid "Show an optional reason field"
msgstr "显示可选的原因字段"

msgid "The customer never has to give a reason; the field is always optional."
msgstr "客户无需说明原因；该字段始终为可选。"

msgid "The acknowledgement of receipt is always sent to the customer, as required by Art. 11a(4)."
msgstr "根据第 11a 条第 4 款，收到确认始终会发送给客户。"

msgid "Customer email subject"
msgstr "客户邮件主题"

msgid "Leave empty for the default text in the store language. You can use {order_id} and {customer_name}."
msgstr "留空则使用商店语言的默认文字。可使用 {order_id} 和 {customer_name}。"

msgid "Status updates"
msgstr "状态变更"

msgid "Email the customer when you change the status of a request"
msgstr "更改申请状态时向客户发送邮件"

msgid "Store notification"
msgstr "商店通知"

msgid "Email the store when a customer withdraws"
msgstr "客户撤回时向商店发送邮件"

msgid "Admin email"
msgstr "管理员邮箱"

msgid "Store email subject"
msgstr "商店邮件主题"

msgid "Order status"
msgstr "订单状态"

msgid "Change order status automatically"
msgstr "自动更改订单状态"

msgid "Change the order status when the customer withdraws"
msgstr "客户撤回时更改订单状态"

msgid "New order status"
msgstr "新的订单状态"

msgid "Refunds are never made automatically: refund the order in WooCommerce once you have checked it."
msgstr "退款从不自动进行：请在检查后于 WooCommerce 中为订单退款。"

msgid "Save settings"
msgstr "保存设置"

msgid "Solicitud no válida (nonce)."
msgstr "无效请求（nonce）。"

msgid "Pedido no encontrado."
msgstr "未找到订单。"

msgid "No tienes permiso para esta acción."
msgstr "您无权执行此操作。"

msgid "Ya has ejercido el desistimiento para este pedido."
msgstr "您已对此订单行使过撤回权。"

msgid "Este pedido no es elegible para desistimiento."
msgstr "此订单不符合撤回条件。"

msgid "Error desconocido."
msgstr "未知错误。"

msgid "Withdrawal exercised by customer. Request ID: %1$d. Reason: %2$s"
msgstr "客户已行使撤回权。申请ID：%1$d。原因：%2$s"

msgid "Not provided"
msgstr "未提供"

msgid "Estado cambiado automáticamente por solicitud de desistimiento."
msgstr "因撤回申请，状态已自动更改。"

msgid "Tu solicitud de desistimiento ha sido registrada correctamente. Recibirás un email de confirmación en breve."
msgstr "您的撤回申请已成功注册。您将很快收到确认电子邮件。"

msgid "Solicito expresamente el acceso inmediato al contenido digital y reconozco que, en cuanto comience a acceder a él, a visualizarlo o a descargarlo, perderé el derecho de desistimiento de 14 días previsto en el artículo 16, letra m), de la Directiva 2011/83/UE (art. 103.m de la TRLGDCU en España)."
msgstr "我明确要求立即访问数字内容，并承认一旦我开始访问、查看或下载该内容，我将失去《指令2011/83/EU》第16条m款规定的14天撤回权。"

msgid "Debes aceptar las condiciones sobre contenido digital para completar tu pedido."
msgstr "您必须接受有关数字内容的条款才能完成订单。"

msgid "Confirmación de desistimiento - Pedido #{order_id}"
msgstr "撤回确认 - 订单 #{order_id}"

msgid "[Desistimiento] Pedido #{order_id} - {customer_name}"
msgstr "[撤回] 订单 #{order_id} - {customer_name}"

msgid "Base legal: artículo 11 bis de la Directiva 2011/83/UE, introducido por la Directiva (UE) 2023/2673"
msgstr "法律依据：由(EU) 2023/2673号指令新增的欧盟第2011/83/EU号指令第11a条"

msgid "Desistimiento del contrato"
msgstr "撤回合同"

msgid "Si quieres desistir de este pedido, puedes hacerlo en línea:"
msgstr "如需撤回此订单，可在线办理："

msgid "Withdrawal Button requires WooCommerce to be active."
msgstr "Withdrawal Button需要WooCommerce处于激活状态。"

msgid "[Desistimiento aprobado] Pedido #{order_id}"
msgstr "[撤回已批准] 订单 #{order_id}"

msgid "[Desistimiento rechazado] Pedido #{order_id}"
msgstr "[撤回已拒绝] 订单 #{order_id}"

msgid "[Desistimiento completado] Pedido #{order_id}"
msgstr "[撤回已完成] 订单 #{order_id}"

msgid "[Desistimiento] Pedido #{order_id}"
msgstr "[撤回] 订单 #{order_id}"

