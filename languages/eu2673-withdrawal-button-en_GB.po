msgstr "Thank you for trusting %s."

msgid "Este correo es el acuse de recibo de tu solicitud de desistimiento."
msgstr "This email is the acknowledgement of receipt of your withdrawal request."

msgid "Your withdrawal request has been <strong>approved</strong>. We will process the full refund within a maximum of <strong>14 calendar days</strong>."
msgstr "Your withdrawal request has been <strong>approved</strong>. We will process the full refund within a maximum of <strong>14 calendar days</strong>."

msgid "Your withdrawal request has been <strong>rejected</strong>. If you have any questions, please contact us."
msgstr "Your withdrawal request has been <strong>rejected</strong>. If you have any questions, please contact us."

msgid "Your withdrawal request has been <strong>completed</strong>. The refund has been processed correctly."
msgstr "Your withdrawal request has been <strong>completed</strong>. The refund has been processed correctly."

