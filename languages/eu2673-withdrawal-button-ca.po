msgid "The customer never has to give a reason; the field is always optional."
msgstr "El client mai no ha de donar cap motiu; el camp sempre és opcional."

msgid "The acknowledgement of receipt is always sent to the customer, as required by Art. 11a(4)."
msgstr "El justificant de recepció s’envia sempre al client, tal com exigeix l’art. 11 bis.4."

msgid "Customer email subject"
msgstr "Assumpte del correu al client"

msgid "Leave empty for the default text in the store language. You can use {order_id} and {customer_name}."
msgstr "Deixa-ho buit per fer servir el text per defecte en la llengua de la botiga. Pots fer servir {order_id} i {customer_name}."

