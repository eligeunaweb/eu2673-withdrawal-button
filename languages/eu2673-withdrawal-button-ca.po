msgid "Si tienes alguna pregunta, responde a este correo."
msgstr "Si tens cap pregunta, respon aquest correu."

msgid "Gracias por confiar en %s."
msgstr "Gràcies per confiar en %s."

msgid "Este correo es el acuse de recibo de tu solicitud de desistimiento."
msgstr "Aquest correu és el justificant de recepció de la teva sol·licitud de desistiment."

msgid "Your withdrawal request has been <strong>approved</strong>. We will process the full refund within a maximum of <strong>14 calendar days</strong>."
msgstr "La teva sol·licitud de desistiment s'ha <strong>aprovat</strong>. Processarem el reemborsament íntegre en un termini màxim de <strong>14 dies naturals</strong>."

msgid "Your withdrawal request has been <strong>rejected</strong>. If you have any questions, please contact us."
msgstr "La teva sol·licitud de desistiment s'ha <strong>rebutjat</strong>. Si tens cap pregunta, posa't en contacte amb nosaltres."

msgid "Your withdrawal request has been <strong>completed</strong>. The refund has been processed correctly."
msgstr "La teva sol·licitud de desistiment s'ha <strong>completat</strong>. El reemborsament s'ha processat correctament."

msgid "Dear"
msgstr "Hola"

