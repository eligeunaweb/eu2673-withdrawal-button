msgid "Hemos recibido correctamente tu solicitud de desistimiento. Este correo es tu acuse de recibo conforme a la Directiva (UE) 2023/2673."
msgstr "Hem rebut correctament la teva sol·licitud de desistiment. Aquest correu és el teu justificant de recepció d'acord amb la Directiva (UE) 2023/2673."

msgid "¿Qué ocurre ahora?"
msgstr "I ara què?"

msgid "Procesaremos el reembolso en un plazo máximo de 14 días naturales desde la recepción de esta solicitud."
msgstr "Processarem el reemborsament en un termini màxim de 14 dies naturals des de la recepció d'aquesta sol·licitud."

msgid "Nombre"
msgstr "Nom"

msgid "Recibirás la confirmación en"
msgstr "Rebràs la confirmació a"

msgid "Motivo indicado"
